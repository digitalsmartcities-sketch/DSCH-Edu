# ===========================================
# Backend environment variables
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored, never commit real credentials.
# ===========================================

# Runtime mode: "production" enables secure cookies and strict CORS.
NODE_ENV=development

# Port the Express server listens on.
PORT=5000

# Public URL of the frontend. Used for CORS allow-list and for the
# links that are embedded in outgoing emails.
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
DB_URL=mongodb://127.0.0.1:27017/dsch-edu

# Secret used to sign and verify JWT cookies. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary (file uploads: institute logos, payment proofs, certificates).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (outgoing mail: verification codes, password resets, notifications).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Address shown as the support contact in the UI and in emails.
SUPPORT_EMAIL=support@example.com
