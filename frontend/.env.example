# ===========================================
# Frontend environment variables
# Copy this file to `.env` and fill in the real values.
# Only variables prefixed with VITE_ are exposed to the browser.
# ===========================================

# Base URL of the backend API.
# Leave it empty to call the same origin that serves the frontend
# (useful when the API is reverse-proxied behind the same domain).
VITE_API_URL=http://localhost:5000

# Registration payment details shown on the admin registration form.
# Leave the account fields empty when online payment is not available; the
# form will then ask applicants to contact support before paying.
VITE_REGISTRATION_FEE=
VITE_PAYMENT_ACCOUNT_TITLE=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_IBAN=
